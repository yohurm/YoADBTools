{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YohuAdbTools",
  "mainBinaryName": "YohuAdbTools",
  "version": "0.1.3",
  "identifier": "com.yohu.adbtools",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../../ui"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../../ui"
    },
    "frontendDist": "../../ui/apps/shell/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Yohu ADB Tools",
        "width": 1200,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768,
        "center": false,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#F1F3F5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../../tools/scrcpy-server": "tools/scrcpy-server"
    }
  }
}
