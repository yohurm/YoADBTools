{
  "adb_path": "",
  "data_root": "",
  "devices_auto_refresh": true,
  "buffer_capacity": 10000,
  "clear_device_on_start": true,
  "theme": "system",
  "density": "comfortable",
  "export_default_path": "",
  "export_ask_every_time": true,
  "log_display_columns": {
    "ts": true,
    "uid": false,
    "pid": true,
    "tid": true,
    "tag": true,
    "app": true,
    "level": true
  },
  "log_time_format": "datetime_millis",
  "log_color_scheme": "yohu",
  "log_line_layout": "clip",
  "mirror_max_size": 0,
